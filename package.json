{
  "name": "@totym/sdk",
  "version": "0.2.0",
  "description": "Token-gated access for any React app. Wallet ownership \u2192 verification \u2192 access.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "solana",
    "token-gating",
    "web3",
    "access-control",
    "totym"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/build-nimbus/Nimbus-SDK.git"
  },
  "homepage": "https://github.com/build-nimbus/Nimbus-SDK#readme",
  "bugs": {
    "url": "https://github.com/build-nimbus/Nimbus-SDK/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}