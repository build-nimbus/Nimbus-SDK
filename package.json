{
  "name": "@totym/sdk",
  "version": "0.2.0",
  "description": "Token-gated access for any React app. Wallet ownership \u2192 verification \u2192 access.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "esbuild scripts/verify-access.ts --bundle --platform=node --format=esm --outfile=.verify/verify-access.mjs --log-level=warning && node .verify/verify-access.mjs",
    "verify:wallet-proof": "node scripts/verify-wallet-proof.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "esbuild": "^0.27.0",
    "react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "solana",
    "token-gating",
    "web3",
    "access-control",
    "totym"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/build-nimbus/nimbus-sdk.git"
  },
  "homepage": "https://github.com/build-nimbus/nimbus-sdk#readme",
  "bugs": {
    "url": "https://github.com/build-nimbus/nimbus-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
